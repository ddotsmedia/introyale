{
  "name": "introyale",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "start": "pnpm -C apps/web start",
    "lint": "eslint . && prettier --check \"apps/web/src/**/*.{ts,tsx,css}\" \"!apps/web/src/payload-types.ts\"",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\"",
    "typecheck": "pnpm -C apps/web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --project=desktop tests/a11y",
    "lhci": "lhci autorun --config=./lighthouserc.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
