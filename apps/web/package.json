{
  "name": "@introyale/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "predev": "pnpm build:tracker",
    "dev": "next dev --port 3000",
    "build": "pnpm build:tracker && next build",
    "build:tracker": "esbuild src/tracker/a.ts --bundle --minify --target=es2020 --format=iife --outfile=public/a.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/worker.js",
    "build:migrate": "esbuild src/migrate.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/migrate.js",
    "build:seed-test": "esbuild scripts/seed-test-leads.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/seed-test-leads.js",
    "build:jobs-trigger": "esbuild scripts/jobs-trigger.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/jobs-trigger.js",
    "build:reset-admin-password": "esbuild scripts/reset-admin-password.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/reset-admin-password.js",
    "build:seed-live": "esbuild scripts/seed-live-content.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/seed-live-content.js",
    "build:seed-legal": "esbuild scripts/seed-legal.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/seed-legal.js",
    "build:admin-user": "esbuild scripts/admin-user.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/admin-user.js",
    "build:seed-analytics-demo": "esbuild scripts/seed-analytics-demo.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/seed-analytics-demo.js",
    "build:seed-motion": "esbuild scripts/seed-motion.ts --bundle --platform=node --format=esm --target=node22 --packages=external --tsconfig=tsconfig.json --outfile=dist/seed-motion.js"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/translations": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "@sentry/nextjs": "11.11.0",
    "altcha": "3.5.0",
    "altcha-lib": "2.8.0",
    "graphql": "^16.15.0",
    "lucide-react": "^1.77.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "otplib": "13.6.0",
    "payload": "3.93.0",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "recharts": "^3.11.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "web-vitals": "6.2.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.5",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "esbuild": "^0.25.12",
    "postcss": "8.5.33",
    "schema-dts": "2.1.0",
    "typescript": "^5.9.3"
  }
}
