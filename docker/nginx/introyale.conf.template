# Mode A (shared VPS): host Nginx vhost. Render with envsubst for ${SERVER_NAME} ${WEB_PORT} ${ENV}.
# Render with BASE=/opt/introyale (home path on Snap-Docker hosts, see decisions-log).
# Install: nginx -t && systemctl reload nginx  (never a global restart; CLAUDE.md).
limit_req_zone $binary_remote_addr zone=introyale_enquiries:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=introyale_admin:10m rate=30r/m;

server {
    listen 80;
    server_name ${SERVER_NAME};
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name ${SERVER_NAME};
    # certbot --nginx -d ${SERVER_NAME} fills these paths
    ssl_certificate /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    client_max_body_size 25m;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Cross-Origin-Opener-Policy same-origin always;

    # add_header X-Robots-Tag "noindex, nofollow" always;

    location /media/ {
        alias ${BASE}/${ENV}/media/;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /api/enquiries { limit_req zone=introyale_enquiries burst=3 nodelay; proxy_pass http://127.0.0.1:${WEB_PORT}; include /etc/nginx/introyale-proxy.inc; }
    location ^~ /admin { limit_req zone=introyale_admin burst=20 nodelay; proxy_pass http://127.0.0.1:${WEB_PORT}; include /etc/nginx/introyale-proxy.inc; }
    location = /api/users/login { limit_req zone=introyale_admin burst=5 nodelay; proxy_pass http://127.0.0.1:${WEB_PORT}; include /etc/nginx/introyale-proxy.inc; }

    location / {
        proxy_pass http://127.0.0.1:${WEB_PORT};
        include /etc/nginx/introyale-proxy.inc;
    }
}
